def signup_create_account():
    # Procedure to create an account
    username = sign_username.value
    password = sign_password.value
    confirm_password = sign_confirm_password.value
    firstname = sign_firstname.value
    lastname = sign_lastname.value
    email = sign_email.value

    # Presence Check
    if not all([username, password, firstname, lastname, email]):
        error("Error", "One or more fields remain empty. Please fill them.")

    # Type Check
    elif username.isalpha() == False:
            error("Error", "Username cannot contain numbers or special characters") # Checks if username has no numbers or special characters (type check)
    elif firstname.isalpha() == False:
            error("Error", "Firstname cannot contain numbers or special characters") # Checks if first name has no numbers or special characters (type check)
    elif lastname.isalpha() == False:
            error("Error", "Firstname cannot contain numbers or special characters") # Checks if last name has no numbers or special characters (type check)

    # Length Check
    elif len(username) < 6 or len(username) > 20:
        error("Error", "Username must be between 6 and 20 characters long.")
    elif len(password) < 6:
        error("Error", "Password must be at least 6 characters.")

    # Format Check
    elif not re.match(r"[^@]+@[^@]+\.[^@]+", email):
        error("Error", "Please enter a valid email address.")
    elif not (re.search(r"[A-Za-z]", password) and re.search(r"\d", password)):
        error("Error", "Password must contain at least one letter and one number.")

    # Confirm Password
    elif confirm_password != password:
        error("Error", "You must confirm your password.")
    
    else:
        # Check for existing username or email
        check_query = "SELECT * FROM User WHERE user_name = ? OR user_email = ?"
        existing = query_database(database_file, check_query, (username, email))
        if existing:
            error("Error", "An account with this username or email already exists.")
        else:
                query = "INSERT INTO User (user_name, user_firstname, user_lastname, user_password, user_email) VALUES (?, ?, ?, ?, ?)"
                execute_sql(database_file, query, (username, firstname, lastname, password, email)) # SQL query to insert new user into User
                info("Success", "Account successfully created")


def submit_review():
    # Procedure to create a review
    date = datetime.today().strftime("%d-%m-%Y")
    additionalinfo = review_textbox.value
