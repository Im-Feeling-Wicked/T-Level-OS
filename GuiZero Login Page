def signup_create_account():
    # Procedure to create an account
    # Retrieve values entered into each sign-up textbox and store them in local variables
    username = sign_username.value
    password = sign_password.value
    confirm_password = sign_confirm_password.value
    firstname = sign_firstname.value
    lastname = sign_lastname.value
    email = sign_email.value

    # Presence Check
    # Checks that none of the fields are empty
    if not all([username, password, firstname, lastname, email]):
        error("Error", "One or more fields remain empty. Please fill them.")

    # Type Check
    # .isalpha() checks checks that the fields only contains alphabetic characters
    elif username.isalpha() == False:
            error("Error", "Username cannot contain numbers or special characters") 
    elif firstname.isalpha() == False:
            error("Error", "First name cannot contain numbers or special characters") 
    elif lastname.isalpha() == False:
            error("Error", "Last name cannot contain numbers or special characters")

    # Length Check
    # Checks that the username is between 6 and 20 characters
    elif len(username) < 6 or len(username) > 20:
        error("Error", "Username must be between 6 and 20 characters long.")
    elif len(password) < 6:
        error("Error", "Password must be at least 6 characters.")

    # Format Check
    # Use a regular expression to check that the email follows a basic email format
    elif not re.match(r"[^@]+@[^@]+\.[^@]+", email):
        error("Error", "Please enter a valid email address.")
    # Check that the password contains both:
    # - at least one letter
    # - at least one number
    elif not (re.search(r"[A-Za-z]", password) and re.search(r"\d", password)):
        error("Error", "Password must contain at least one letter and one number.")

    # Confirm Password
    # Check that the confirmation password matches the original password
    elif confirm_password != password:
        error("Error", "You must confirm your password.")
    
    else:
        # Search the database to see whether another account already uses the username or email
        check_query = "SELECT * FROM User WHERE user_name = ? OR user_email = ?"
        existing = query_database(database_file, check_query, (username, email))
        # If a matching account was found, prevent another account from being created
        if existing:
            error("Error", "An account with this username or email already exists.")
        else:
            # SQL INSERT statement used to add the new user's details to the User table
            query = "INSERT INTO User (user_name, user_firstname, user_lastname, user_password, user_email) VALUES (?, ?, ?, ?, ?)"
            # Execute the INSERT query and pass the user's information as parameters
            execute_sql(database_file, query, (username, firstname, lastname, password, email)) 
            # Tell the user their account was created
            info("Success", "Account successfully created")


