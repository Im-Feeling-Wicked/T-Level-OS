def signup_create_account():
    # Procedure to create an account
    username = sign_username.value
    password = sign_password.value
    firstname = sign_firstname.value
    lastname = sign_lastname.value
    email = sign_email.value

    # Presence Check
    if not all([username, password, firstname, lastname, email]):
        info("Error", "One or more fields remain empty. Please fill them.")

    # Type Check
    elif username.isalpha() == False:
            info("Error", "Username cannot contain numbers or special characters") # Checks if username has no numbers or special characters (type check)
    elif firstname.isalpha() == False:
            info("Error", "Firstname cannot contain numbers or special characters") # Checks if first name has no numbers or special characters (type check)

    # Length Check
    elif len(username) < 6 or len(username) > 20:
        info("Error", "Username must be between 6 and 20 characters long.")
    elif len(password) < 6:
        info("Error", "Password must be longer than 6 characters.")

    # Format Check
    elif not re.match(r"[^@]+@[^@]+\.[^@]+", email):
        info("Error", "Please enter a valid email address.")
    elif not (re.search(r"[A-Za-z]", password) and re.search(r"\d", password)):
        info("Error", "Password must contain at least one letter and one number.")

    
    
    else:
            query = "INSERT INTO User (user_name, user_firstname, user_lastname, user_password, user_email) VALUES (?, ?, ?, ?, ?)"
            execute_sql(database_file, query, (username, firstname, lastname, password, email)) # SQL query to insert new user into User
            info("Success", "Account successfully created")


