#---------------------

# SQL commands used to create tables required for program
# User table stores information about each user
# UserID is primary key and automatically increases when a new user is created
# 
# Review table stores reviews submitted by users
# UserID is a foreign key which links each review back to the user who submitted it
sql = """
CREATE TABLE IF NOT EXISTS "User" (
"UserID" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
"user_name" TEXT,
"user_firstname" TEXT,
"user_lastname" TEXT,
"user_password" TEXT,
"user_email" TEXT
);
CREATE TABLE IF NOT EXISTS "Review" (
"ReviewID" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
"review_date" TEXT,
"review_additionalinfo" TEXT,
"review_stars" INTEGER,
"UserID" INTEGER,
FOREIGN KEY(UserID) REFERENCES User(UserID)
);


"""



