def query_database(database, query, params=()):
	# Function to query the database
    with sqlite3.connect(database) as conn:
        cur = conn.cursor()
        cur.execute(query, params)
        rows = cur.fetchall()
    return rows


def execute_sql(database, sql_statement, params=()):
	# Function to execute SQL statements
    with sqlite3.connect(database) as conn:
        cur = conn.cursor()
        cur.execute(sql_statement, params)
        conn.commit()
    return cur.lastrowid


def login_user():
    # Procedure used to check login details against information stored in database
    global user_LoggedIn # Allows procedure to change global user_LoggedIn variable
    # Presence Checks
    if login_username.value == "":
        error("Error", "You must enter a valid username") 
    elif login_password.value == "":
        error("Error", "You must enter a valid password") 
    else:
        # SQL query used to find a user whose username and password match the values entered
        # The ? placeholders are used so that the values can be safely passed into the query
        query = "SELECT * from User WHERE user_name = ? AND user_password = ?"
        # Run the query using the username and password entered by the user
        rows = query_database(database_file, query, (login_username.value, login_password.value))
