    elif stars == 0:
        error("Error", "Please select a star rating.")
    else:
        query = "INSERT INTO Review (review_date, review_additionalinfo, review_stars, UserID) VALUES (?, ?, ?, ?)"
        execute_sql(database_file, query, (date, additionalinfo, stars, user_LoggedIn))
